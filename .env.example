# Copy to .env and adjust before running `docker compose up`.
# All values below are development defaults — replace JWT_SECRET for anything
# beyond local use.

DB_USERNAME=aegiszero
DB_PASSWORD=aegiszero

# DB_SCHEMA is deliberately not set here. Locally each service gets its own
# database (auth_db, user_db, ...) and leaves its tables in `public`, which is
# what an unset DB_SCHEMA means. It only matters on Render, where the free
# Postgres plan allows a single database and render.yaml gives each service a
# schema inside it instead.

# Must be identical across every service; used to sign/verify JWTs (HS384).
JWT_SECRET=change-this-secret-change-this-secret-change-this-secret

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Host-side port overrides, only needed if the defaults collide with
# something else already running on your machine.
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9095
KAFKA_UI_HOST_PORT=8091
MAILHOG_WEB_HOST_PORT=8026
MAILHOG_SMTP_HOST_PORT=1026

# Baked into the frontend's client bundle at build time (not runtime).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Event backend ----------------------------------------------------------
# EVENT_BACKEND picks what carries domain events between services:
#   kafka (default) — the bundled Kafka container. Nothing below is needed for
#                     `docker compose up`.
#   redis           — Redis Streams instead, over the same Redis used for
#                     sessions. This is what render.yaml sets, because Render
#                     has no managed Kafka and can't self-host one (its
#                     `type: web` health check expects an HTTP response, which
#                     a broker never gives). Consumer groups provide the same
#                     fan-out and offsets, so behaviour is unchanged.
# Either way no service code differs — see shared/common-messaging.
#
# EVENT_BACKEND=kafka
# AEGISZERO_EVENTS_REDIS_MAX_STREAM_LENGTH=1000

# --- Kafka (only when EVENT_BACKEND=kafka and the broker is remote) ----------
# Left unset, every service talks PLAINTEXT to the local Kafka container. Fill
# these in only to point at a managed broker that requires SASL_SSL.
#
# KAFKA_BOOTSTRAP_SERVERS=your-broker-host:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="your-username" password="your-password";

# --- Outgoing email (notification-service) ---------------------------------
# EMAIL_PROVIDER picks how notification-service actually sends mail:
#   smtp       (default) — JavaMailSender. Works for local Mailhog and any
#              host that allows outbound SMTP.
#   brevo-api  — Brevo's REST API over HTTPS (port 443) instead of SMTP.
#              Required on Render's free tier, which blocks outbound SMTP
#              ports (25/465/587) entirely — SMTP_* below would just time
#              out there. See render.yaml, which already sets this.
EMAIL_PROVIDER=smtp

# --- Mode A: local development (EMAIL_PROVIDER=smtp) ------------------------
# Left unset, these default to the bundled Mailhog container (catches every
# email locally, nothing leaves your machine — see http://localhost:8026).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Mode B: SMTP deployment (EMAIL_PROVIDER=smtp, on a host that allows it)-
# Point this at a real SMTP relay instead of Mailhog. Brevo's free tier (300
# emails/day, no time limit) works well for a project this size:
#   1. Create a Brevo account, verify a sender address.
#   2. SMTP & API > SMTP > generate an SMTP key.
#   3. Uncomment and fill in the block below (and comment out the Mailhog
#      values above).
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=your-brevo-login-email
# SMTP_PASSWORD=your-brevo-smtp-key

# --- Mode C: Render Free (EMAIL_PROVIDER=brevo-api) --------------------------
# Same Brevo account as above, different credential: SMTP & API > API Keys >
# generate a new API key (not the SMTP key from Mode B). Set on the
# notification-service directly in Render's dashboard — see render.yaml's
# comments — not needed for local `docker compose up`.
#
# EMAIL_PROVIDER=brevo-api
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=no-reply@yourdomain.com
# MAIL_FROM_NAME=AegisZero Security
